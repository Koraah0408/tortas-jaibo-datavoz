# Copia este archivo como .env y completa tu llave. NUNCA subas el archivo .env a GitHub.

# --- Modelo de lenguaje principal: Google Gemini (capa gratuita) ---
# Obtén tu llave en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Modelo rápido para Orquestador, Visualizador, Narrador y Limpiador
GEMINI_MODELO=gemini-3.1-flash-lite
# Modelo para el Analista SQL
GEMINI_MODELO_SQL=gemini-3.5-flash-lite
# Respaldo automático cuando se agota la cuota diaria del principal (cada modelo tiene la suya)
GEMINI_MODELOS_RESPALDO=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash

# --- Respaldos automáticos si Gemini falla o se agota la cuota ---
LLM_PROVEEDOR=gemini
LLM_RESPALDOS=groq,ollama
# https://console.groq.com/keys (opcional)
GROQ_API_KEY=
GROQ_MODELO=llama-3.3-70b-versatile
# Ollama local (opcional): ollama pull llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.1:8b

# --- Límites y caché (capa gratuita) ---
LLM_PETICIONES_POR_MINUTO=10
LLM_CACHE=1
LLM_TIMEOUT=30
# Presupuesto de "razonamiento" para el Analista SQL (solo aplica a Gemini 2.5 Flash; 0 = sin razonamiento)
GEMINI_RAZONAMIENTO_SQL=512

# --- Ejecución de SQL ---
SQL_TIMEOUT=10
SQL_MAX_FILAS=500
SQL_MAX_REINTENTOS=2

# --- Voz (faster-whisper local) ---
WHISPER_MODELO=small
WHISPER_DISPOSITIVO=cpu

# --- Agentes ---
# 1 = el Visualizador consulta al LLM cuando la gráfica es ambigua (las obvias se deciden con reglas); 0 = solo reglas
VISUALIZADOR_LLM=1

# --- Opcional: trazas en LangSmith ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=datavoz

# --- Opcional: Tortas Jaibo (copia de solo lectura del POS en Supabase) ---
# Antes corre docs/jaibo/supabase_usuario_lectura.sql en Supabase (ver docs/jaibo/CONEXION.md).
# Usa el "Session pooler" de Supabase (Connect > Session pooler), puerto 5432.
JAIBO_PG_HOST=
JAIBO_PG_PORT=5432
JAIBO_PG_DB=postgres
# En el pooler el usuario lleva el id del proyecto: datavoz_lector.<id-del-proyecto>
JAIBO_PG_USUARIO=datavoz_lector.<id-del-proyecto>
JAIBO_PG_CONTRASENA=
JAIBO_PG_SSLMODE=require
# Minutos mínimos entre descargas automáticas (el botón "Actualizar" siempre descarga)
JAIBO_SINCRONIZAR_CADA_MIN=30
